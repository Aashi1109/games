# Only application sources and the approved runtime models, atlases, and portraits enter Docker.
**
!Dockerfile
!.dockerignore
!package.json
!pnpm-lock.yaml
!pnpm-workspace.yaml
!index.html
!client/
client/*
!client/*.js
!client/*.css
!server/
server/*
!server/*.js
!shared/
!shared/**
!public/
!public/**
!output/
output/*
!output/models/
output/models/*
!output/models/tripo-runtime/
output/models/tripo-runtime/*
!output/models/tripo-runtime/ember-character.glb
!output/models/tripo-runtime/wisp-character.glb
!output/models/tripo-runtime/dash-character.glb
!output/models/tripo-runtime/rook-character.glb
!output/models/tripo-runtime/ember-gun.glb
!output/models/tripo-runtime/wisp-gun.glb
!output/models/tripo-runtime/dash-gun.glb
!output/models/tripo-runtime/rook-gun.glb
!output/models/tripo-runtime/characters-color.png
!output/models/tripo-runtime/characters-metallic-roughness.jpg
!output/models/tripo-runtime/characters-normal.png
!output/models/tripo-runtime/guns-color.jpg
!output/models/tripo-runtime/guns-metallic-roughness.jpg
!output/models/tripo-runtime/guns-normal.png
!output/models/tripo-runtime/ember-portrait.png
!output/models/tripo-runtime/wisp-portrait.png
!output/models/tripo-runtime/dash-portrait.png
!output/models/tripo-runtime/rook-portrait.png
**/.env*
**/.DS_Store
