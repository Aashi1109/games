# Defaults for a local Node server. The Dockerfile sets HOST=0.0.0.0 and PORT=8080.
HOST=127.0.0.1
PORT=4180

# Enable behind Coolify's Traefik proxy only when clients cannot connect directly
# to the application. A custom proxy must overwrite X-Real-IP with the client IP.
# Leave false for a direct Node connection.
TRUST_PROXY=false
